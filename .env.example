NODE_ENV=development
HOST=127.0.0.1
PORT=4001
LOG_LEVEL=info

# Exact admin FRONTEND origins. Add your HTTPS admin domain for deployment.
ADMIN_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Use the existing platform database; migrations create only admin-specific tables.
DB_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=choicestakes
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false
MYSQL_SSL_CA=

ADMIN_SESSION_TTL_HOURS=8
APIMATIC_CURRENCY=USD
# Match SESSION_IDLE_MINUTES in the player backend (used for the active-session count).
PLAYER_SESSION_IDLE_MINUTES=60
ADMIN_SESSION_IDLE_MINUTES=30
# Only for the optional integration test: an EXISTING disposable database ending in _test.
MYSQL_TEST_DATABASE=

